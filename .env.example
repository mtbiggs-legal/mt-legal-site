ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Optional: override the Claude model used for research/drafting
# Default: claude-haiku-4-5-20251001  |  Upgrade: claude-sonnet-4-6
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Attorney portal credentials (bcrypt hashes).
# Generate a hash: python3 -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
ATTORNEY_ENDOCIDE_HASH=your-bcrypt-hash-here
ATTORNEY_SOPHIAH_HASH=your-bcrypt-hash-here

# Optional: set a password to protect the app when sharing publicly.
# Leave blank (or remove the line) for local-only use with no password prompt.
SHARE_PASSWORD=

# Your timezone for Google Calendar events.
# Common US values: America/New_York  America/Chicago  America/Denver  America/Los_Angeles
TIMEZONE=America/Chicago

# Payment processing
HOURLY_RATE=350
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
COINBASE_COMMERCE_API_KEY=...
COINBASE_COMMERCE_WEBHOOK_SECRET=...

# ── Email auto-reply (SendGrid) ───────────────────────────────────────────────
# 1. Sign up free at https://sendgrid.com
# 2. Settings → API Keys → Create API Key (Full Access)
# 3. Settings → Sender Authentication → verify your FROM_EMAIL domain or single sender
SENDGRID_API_KEY=SG.your-api-key-here
FROM_EMAIL=info@your-domain.com
FROM_NAME=MT Legal

# ── Cal.com consultation booking ──────────────────────────────────────────────
# 1. Sign up free at https://cal.com
# 2. Create event "Free Consultation" (20 min) and connect Google Calendar
# 3. Paste your booking link below
CAL_BOOKING_URL=https://cal.com/your-username/free-consultation

# ── Firm contact (shown in auto-reply emails) ──────────────────────────────────
FIRM_PHONE=(615) 000-0000
FIRM_WEBSITE=https://your-domain.com
# Claude model used to read scheduling orders
SCHEDULING_ORDER_MODEL=claude-opus-5-5

# ── Required secrets ──────────────────────────────────────────────────────────
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# python scripts/generate_data_key.py  (back it up OUTSIDE this folder)
DATA_ENCRYPTION_KEY=

# ── Deployment (see docs/DEPLOY.md) ───────────────────────────────────────────
# APP_ENV=production enables HTTPS-only cookies, HSTS, and strict startup checks.
APP_ENV=
# 1 = public site and intake only; portals, logins, and attorney tools are off.
PUBLIC_SITE_ONLY=
# Folder for runtime data (client records, leads); a persistent disk in hosting.
DATA_DIR=
# Inbox that receives intake and lead alerts (defaults to FROM_EMAIL).
FIRM_EMAIL=
